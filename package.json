{
  "name": "chih-kai-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "locale": "node scripts/build-zh-hans.mjs",
    "profile": "node scripts/render-profile.mjs",
    "profile:sync": "node scripts/sync-profile.mjs",
    "check": "node scripts/render-profile.mjs --check && node scripts/build-zh-hans.mjs --check && tsc -b --pretty false",
    "build": "node scripts/render-profile.mjs --check && node scripts/build-zh-hans.mjs --check && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "jetbrains-mono": "^1.0.6",
    "preact": "^10.27.1",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "fontkit": "^2.0.4",
    "opencc-js": "^1.4.2",
    "subset-font": "^2.9.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
